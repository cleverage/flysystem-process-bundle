{
    "name": "cleverage/flysystem-process-bundle",
    "description": "Dedicated bundle for Flysystem dependencies for the Process Bundle",
    "keywords": [
        "process",
        "task",
        "etl",
        "transformation",
        "import",
        "export",
        "flysystem"
    ],
    "homepage": "https://github.com/cleverage/flysystem-process-bundle",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Nicolas Joubert",
            "email": "njoubert@clever-age.com",
            "homepage": "https://github.com/njoubert-cleverage",
            "role": "Maintainer"
        },
        {
            "name": "Xavier Marchegay",
            "email": "xmarchegay@clever-age.com",
            "homepage": "https://github.com/xaviermarchegay",
            "role": "Maintainer"
        },
        {
            "name": "Grégory Tonon",
            "email": "gtonon@clever-age.com",
            "homepage": "https://github.com/clever-age-gtonon",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/cleverage/flysystem-process-bundle/issues",
        "source": "https://github.com/cleverage/flysystem-process-bundle",
        "docs": "https://github.com/cleverage/flysystem-process-bundle/blob/main/docs/index.md",
        "security": "https://github.com/cleverage/flysystem-process-bundle/security/policy"
    },
    "autoload": {
        "psr-4": {
            "CleverAge\\FlysystemProcessBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CleverAge\\FlysystemProcessBundle\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "cleverage/process-bundle": "^5.4",
        "league/flysystem": "^3.0",
        "league/flysystem-bundle": "^3.2",
        "psr/log": "^2|^3",
        "symfony/config": "^6.4|^7.4|^8",
        "symfony/dependency-injection": "^6.4|^7.4|^8",
        "symfony/deprecation-contracts": "^2.5|^3",
        "symfony/http-kernel": "^6.4|^7.4|^8",
        "symfony/options-resolver": "^6.4|^7.4|^8",
        "symfony/polyfill-php83": "^1.33",
        "symfony/polyfill-php84": "^1.33",
        "symfony/polyfill-php85": "^1.33"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "*",
        "league/flysystem-local": "^3.0",
        "phpstan/extension-installer": "*",
        "phpstan/phpstan": "*",
        "phpstan/phpstan-symfony": "*",
        "phpunit/phpunit": "^10.5|^11|^12|^13",
        "rector/rector": "*",
        "roave/security-advisories": "dev-latest",
        "symfony/filesystem": "^6.4|^7.4|^8",
        "symfony/framework-bundle": "^6.4|^7.4|^8",
        "symfony/test-pack": "^1.1"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    }
}
